{
  "name": "prototype-edit-llm",
  "version": "0.1.0",
  "description": "Natural language driven prototype editor with thunder and Lobe UI",
  "main": "./out/main/index.js",
  "author": "lucas",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "rm -rf node_modules/.vite out && electron-vite dev",
    "clean": "rm -rf node_modules/.vite out dist",
    "build": "electron-vite build",
    "postinstall": "node -e \"require('electron')\" && electron-builder install-app-deps",
    "build:sidecars": "node scripts/prepare-sidecars.mjs",
    "fetch:thunder": "node scripts/fetch-thunder-binaries.mjs --from-release",
    "fetch:thunder:local": "node scripts/fetch-thunder-binaries.mjs --from-checkout /Users/lucas/wz/ag/thunder",
    "sync:thunder:local": "node scripts/fetch-thunder-binaries.mjs --from-checkout /Users/lucas/wz/ag/thunder --bless",
    "verify:sidecars": "node scripts/fetch-thunder-binaries.mjs --verify",
    "prebuild:mac": "node scripts/prepare-sidecars.mjs",
    "prebuild:unpack": "node scripts/prepare-sidecars.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@lobehub/icons": "^5.23.0",
    "@lobehub/ui": "^5.57.3",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.5",
    "antd-style": "^4.1.0",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.46.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.1.0",
    "postcss": "^8.5.29",
    "sass": "^1.71.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "type": "module"
}
