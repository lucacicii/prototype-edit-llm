{
  "name": "prototype-edit-llm",
  "version": "0.1.0",
  "description": "Natural language driven UI prototype editor with wb-ui and thunder",
  "main": "./out/main/index.js",
  "author": "lucas",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "rm -rf node_modules/.vite out && electron-vite dev",
    "clean": "rm -rf node_modules/.vite out dist",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^10.9.0",
    "dayjs": "^1.11.10",
    "element-plus": "^2.6.1",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.46.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.4.21",
    "autoprefixer": "^10.6.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.5.29",
    "sass": "^1.71.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vue-tsc": "^1.8.27"
  },
  "type": "module"
}
